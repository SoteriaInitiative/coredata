<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:goaml="http://www.unodc.org/goaml" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" xmlns:xerces="http://xerces.apache.org" xmlns:altova="http://www.altova.com/xml-schema-extensions" id="report" vc:minVersion="1.1" goaml:schemaVersion="5.0.2">
  <xs:element name="report">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="schema_version" minOccurs="0" goaml:supportedIn="5.1">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="0" />
              <xs:maxLength value="25" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="rentity_id">
          <xs:simpleType>
            <xs:restriction base="xs:int">
              <xs:minInclusive value="1" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="rentity_branch" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="0" />
              <xs:maxLength value="255" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="submission_code" type="submission_type" fixed="E" minOccurs="1" />
        <xs:element name="report_code" type="report_type" />
        <xs:element name="entity_reference">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="255" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="fiu_ref_number" nillable="true" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="255" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="prev_rejected_ref_number" minOccurs="0" goaml:supportedIn="5.1">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="255" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:choice>
          <xs:element name="submission_date" type="sql_date">
            <xs:annotation>
              <xs:documentation>The element will be deprecated in Schema 6</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="report_date" type="sql_date" goaml:supportedIn="5.0" />
        </xs:choice>
        <xs:element name="currency_code_local" type="currency_type" fixed="CHF" />
        <xs:choice minOccurs="0">
          <xs:element name="reporting_person" type="t_person_registration_in_report" />
          <xs:element name="reporting_user_code" goaml:supportedIn="5.1">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:minLength value="4" />
                <xs:maxLength value="50" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:choice>
        <xs:element name="location" type="t_address" />
        <xs:element name="reason" type="comments_type" />
        <xs:element name="action" type="comments_type" />
        <xs:choice>
          <xs:sequence>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="transaction">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="transactionnumber">
                      <xs:simpleType>
                        <xs:annotation>
                          <xs:documentation>The transaction number length was extended to 100 chars</xs:documentation>
                        </xs:annotation>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="100" />
                          <xs:minLength value="1" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_is_suspicious" type="xs:boolean" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                    <xs:element name="internal_ref_number" minOccurs="0">
                      <xs:simpleType>
                        <xs:annotation>
                          <xs:documentation>The internal ref number length was extended to 100 chars</xs:documentation>
                        </xs:annotation>
                        <xs:restriction base="xs:string">
                          <xs:minLength value="1" />
                          <xs:maxLength value="100" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="agent_name" minOccurs="0" goaml:supportedIn="5.1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="255" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_location" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:minLength value="0" />
                          <xs:maxLength value="255" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_address" type="t_address" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                    <xs:element name="transaction_description" type="comments_type" />
                    <xs:element name="date_transaction" type="sql_date" />
                    <xs:element name="teller" nillable="true" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="20" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="authorized" minOccurs="0" maxOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="20" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:sequence minOccurs="0" maxOccurs="0">
                      <xs:element name="late_deposit" type="xs:boolean" minOccurs="0" maxOccurs="0" />
                      <xs:element name="date_posting" type="sql_date" minOccurs="0" maxOccurs="0" />
                    </xs:sequence>
                    <xs:element name="value_date" type="sql_date" minOccurs="0" />
                    <xs:element name="transaction_type_code" type="transaction_type" goaml:supportedIn="5.1" />
                    <xs:element name="transmode_code" type="conduction_type" minOccurs="0" maxOccurs="0" />
                    <xs:element name="transmode_comment" nillable="true" minOccurs="0" maxOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="amount_local">
                      <xs:simpleType>
                        <xs:restriction base="sql_decimal" />
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_status" type="transaction_status_type" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                    <xs:choice>
                      <xs:element name="involved_parties">
                        <xs:complexType>
                          <xs:sequence maxOccurs="unbounded">
                            <xs:element name="party" type="t_party" />
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                      <xs:sequence>
                        <xs:choice>
                          <xs:element name="t_from_my_client">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="from_funds_code" type="funds_type" />
                                <xs:element name="from_funds_comment" minOccurs="0">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="from_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" goaml:supportedIn="5.1" />
                                <xs:element name="from_foreign_currency" type="t_foreign_currency" />
                                <xs:sequence minOccurs="0">
                                  <xs:element name="conductor_is_suspected" type="xs:boolean" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:element name="t_conductor" type="t_conductor_my_client" minOccurs="0" maxOccurs="0" />
                                </xs:sequence>
                                <xs:sequence>
                                  <xs:element name="from_is_suspected" type="xs:boolean" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="from_account" type="t_account_my_client" />
                                    <xs:element name="from_person" type="t_person_my_client" />
                                    <xs:element name="from_entity" type="t_entity_my_client" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="from_country" type="country_type" minOccurs="0" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="t_from">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="from_funds_code" type="funds_type" />
                                <xs:element name="from_funds_comment" minOccurs="0">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="from_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                <xs:element name="from_foreign_currency" type="t_foreign_currency" minOccurs="0" />
                                <xs:sequence minOccurs="0">
                                  <xs:element name="conductor_is_suspected" type="xs:boolean" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:element name="t_conductor" type="t_conductor" minOccurs="0" maxOccurs="0" />
                                </xs:sequence>
                                <xs:sequence>
                                  <xs:element name="from_is_suspected" type="xs:boolean" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="from_account" type="t_account" />
                                    <xs:element name="from_person" type="t_person" />
                                    <xs:element name="from_entity" type="t_entity" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="from_country" type="country_type" minOccurs="0" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:choice>
                        <xs:choice>
                          <xs:element name="t_to_my_client">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="to_funds_code" type="funds_type" />
                                <xs:element name="to_funds_comment" minOccurs="0">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="to_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" goaml:supportedIn="5.1" />
                                <xs:element name="to_foreign_currency" type="t_foreign_currency" />
                                <xs:sequence>
                                  <xs:element name="to_is_suspected" type="xs:boolean" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="to_account" type="t_account_my_client" />
                                    <xs:element name="to_person" type="t_person_my_client" />
                                    <xs:element name="to_entity" type="t_entity_my_client" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="to_country" type="country_type" minOccurs="0" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="t_to">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="to_funds_code" type="funds_type" />
                                <xs:element name="to_funds_comment" minOccurs="0">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="to_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                <xs:element name="to_foreign_currency" type="t_foreign_currency" minOccurs="0" />
                                <xs:sequence>
                                  <xs:element name="to_is_suspected" type="xs:boolean" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="to_account" type="t_account" />
                                    <xs:element name="to_person" type="t_person" />
                                    <xs:element name="to_entity" type="t_entity" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="to_country" type="country_type" minOccurs="0" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:choice>
                      </xs:sequence>
                    </xs:choice>
                    <xs:element name="goods_services" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence maxOccurs="unbounded">
                          <xs:element name="item" type="t_trans_item" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="means_of_transport" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.2">
                      <xs:complexType>
                        <xs:sequence maxOccurs="unbounded">
                          <xs:element name="routing" type="route_type" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="comments" type="comments_type" minOccurs="0" />
                  </xs:sequence>
                  <xs:assert test="empty(transmode_code) = false() or empty(transaction_type_code) = false()" xerces:message="One of transmode_code and transaction_type_code must be completed " />
                  <xs:assert test="not((amount_local eq 0) and not(involved_parties)) " xerces:message="the transaction amount has to be greater 0, unless it is a 'Multiparty Dummy transaction'" />
                  <xs:assert test="not (involved_parties and amount_local != 0)" xerces:message="MultiParty Transactions are not 'real' transactions and are only used to report persons, companies and accounts that are not involved in 'real' transactions. Therefore, no amount can be entered for MultiParty transactions. If electronic transfers are involved, you must replace MultiParty transactions with BiParty transactions." />
                  <xs:assert test="if (transaction_type_code = 'MUPAD') then not(empty(involved_parties) or not(involved_parties)) else true()" xerces:message="Categorization as multiparty in transaction_type_code not possible for biparty transactions" />
                  <xs:assert test="if (empty(involved_parties)) then not(not(t_from_my_client) and not(t_to_my_client)) else true()" xerces:message="When you enter a BiParty transaction or transfer, at least one party must be your customer. Please correct the transaction and use 'account (reported subject)' and not 'account' for your customer account. 'Account' is used for accounts with third party banks." />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:element name="activity" type="activityType" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.0" />
          </xs:sequence>
          <xs:element name="activity" type="activityType" />
        </xs:choice>
        <xs:element name="report_indicators">
          <xs:complexType>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="indicator" type="report_indicator_type" />
            </xs:sequence>
            <xs:assert test="count(indicator[ends-with(., 'M')]) = 1" xerces:message="one indicator from type M must be provided" />
            <xs:assert test="count(indicator[ends-with(., 'V')]) &gt; 0" xerces:message="at least one indicator from type V must be provided" />
            <xs:assert test="count(indicator[ends-with(., 'G')]) &gt; 0" xerces:message="at least one indicator from type G must be provided" />
          </xs:complexType>
        </xs:element>
        <xs:element name="additional_information" minOccurs="0" maxOccurs="unbounded" goaml:supportedIn="5.2">
          <xs:complexType>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="additional_info" type="generic_additional_info_type" minOccurs="0" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:assert test="if (report_code = ('CANCL', 'CANCT')) then  not(fiu_ref_number eq '' or empty( fiu_ref_number))  else true()" xerces:message="fiu_ref_number must be provided for CANCL or CANCT" />
      <xs:assert test="if (report_code = ('CANCL', 'CANCT')) then report_indicators/indicator = ('0024M') and report_indicators/indicator = ('1207V') and report_indicators/indicator = ('2103G') else true()" xerces:message="CANCL CANCT reports must have indicators 0024M, 1207V and 2103G" />
      <xs:assert test="if (report_indicators/indicator = ('0003M')) then report_code eq 'SAR' else true()" xerces:message="Indicator 0003M can only be used for SAR" />
      <xs:assert test="not (report_code = ('STR', 'AIFT') and  count(transaction/t_from_my_client) = 0 and count(transaction/t_to_my_client) = 0 and count(transaction/t_from) = 0 and count(transaction/t_to) = 0)" xerces:message="STR Reports must contain at least 1 Bi-Party Transaction." />
      <xs:assert test="if (report_indicators/indicator = ('0003M') or not(report_code = ('SAR', 'STR'))) then true() else additional_information/additional_info/info_type = ('BRNR') and (additional_information/additional_info/info_numeric &gt; 0)" xerces:message="number of relationship greater than 0 must be in additional info with code BRNR provided" />
    </xs:complexType>
  </xs:element>
  <xs:complexType name="t_account_my_client">
    <xs:sequence>
      <xs:element name="institution_name">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="255" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:choice>
        <xs:element name="institution_code" minOccurs="0" maxOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="1" />
              <xs:maxLength value="50" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="swift">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="11" />
              <xs:minLength value="1" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:choice>
      <xs:element name="institution_country" type="country_type" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
      <xs:element name="non_bank_institution" type="xs:boolean" minOccurs="0" maxOccurs="0" />
      <xs:element name="collection_account" type="xs:boolean" fixed="1" minOccurs="0" goaml:supportedIn="5.1" />
      <xs:element name="branch">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="2" />
            <xs:minLength value="2" />
            <xs:pattern value="(AG|AI|AR|BE|BL|BS|FR|GE|GL|GR|JU|LU|NE|NW|OW|SG|SH|SO|SZ|TG|TI|UR|VD|VS|ZG|ZH){1}" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="account_category" type="account_category_type" goaml:supportedIn="5.1" />
      <xs:element name="account">
        <xs:annotation>
          <xs:documentation>
        The account length was extended to 255 chars
      </xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="255" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="currency_code" type="currency_type" />
      <xs:element name="account_funds" minOccurs="0" goaml:supportedIn="5.1">
        <xs:complexType>
          <xs:sequence maxOccurs="unbounded">
            <xs:element name="account_fund" type="account_fund_type" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="account_name" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="255" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="iban" type="iban_type" />
      <xs:element name="client_number">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="30" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:choice>
        <xs:element name="personal_account_type" type="account_type" minOccurs="0" maxOccurs="0">
          <xs:annotation>
            <xs:documentation>The element will be deprecated in Schema 6 and replaced by the new account_type element</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="account_type" type="account_type" goaml:supportedIn="5.1" />
      </xs:choice>
      <xs:element name="t_entity" type="t_entity_my_client" minOccurs="0" />
      <xs:element name="related_entities" minOccurs="0" goaml:supportedIn="5.1">
        <xs:complexType>
          <xs:sequence maxOccurs="unbounded">
            <xs:element name="account_related_entity" type="account_related_entity_type" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:choice>
        <xs:element name="signatory" minOccurs="0" maxOccurs="0">
          <xs:annotation>
            <xs:documentation>The signatory node will be deprecated in Schema 6 and replaced by the new node related_persons</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="is_primary" fixed="1" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:boolean" />
                </xs:simpleType>
              </xs:element>
              <xs:element name="t_person" type="t_person_my_client" />
              <xs:element name="role" type="account_person_role_type" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="related_persons" goaml:supportedIn="5.1">
          <xs:complexType>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="account_related_person" type="account_related_person_my_client_type" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:element name="related_accounts" minOccurs="0" goaml:supportedIn="5.1">
        <xs:complexType>
          <xs:sequence maxOccurs="unbounded">
            <xs:element name="account_related_account" type="account_related_account_type" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="opened" type="sql_date" />
      <xs:element name="closed" type="sql_date" minOccurs="0" />
      <xs:sequence minOccurs="0">
        <xs:element name="balance" type="sql_decimal" />
        <xs:element name="date_balance" type="sql_date" />
      </xs:sequence>
      <xs:sequence>
        <xs:element name="status_code" type="account_status_type" />
        <xs:element name="status_date" type="sql_date" minOccurs="0" maxOccurs="0" goaml:supportedIn="5.1" />
      </xs:sequence>
      <xs:element name="beneficiary" nillable="true" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:decimal" />
        </xs:simpleType>
      </xs:element>
      <xs:element name="beneficiary_comment">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="255" />
            <xs:minLength value="1" />
          </xs:restriction>
